# NEXUS API keys & webhook endpoints
# Copy to config/.keys.env (git-ignored) and fill in real values.
# NEVER commit real values. NEVER hard-code keys in code.
# Multiple keys per provider: OPENAI_API_KEY, OPENAI_API_KEY_2 ... _10
# (or comma-separated) — the AI client fails over automatically.

# --- Discord webhooks (separate channels) ---
DISCORD_FINDINGS_WEBHOOK=
DISCORD_CVE_WEBHOOK=
DISCORD_METRICS_WEBHOOK=

# --- Discord / Telegram C2 bot ---
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
C2_OWNER_ID=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Platform APIs ---
HACKERONE_API_USERNAME=
HACKERONE_API_TOKEN=
BUGCROWD_API_KEY=
INTIGRITI_API_KEY=
YESWEHACK_API_KEY=

# --- NVD (optional, raises rate limit) ---
NVD_API_KEY=

# --- OSINT / dorking (optional) ---
GITHUB_TOKEN=

# --- AI providers (any OpenAI-compatible; multi-key failover supported) ---
# provider order lives in nexus.yaml: ai.provider + ai.fallback_providers
OPENAI_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
OPENROUTER_API_KEY=
# Custom/self-hosted OpenAI-compatible endpoint:
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
# Per-provider override examples (optional):
# OPENAI_BASE_URL=https://your-proxy/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
